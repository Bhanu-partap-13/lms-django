# ==============================================================================
# ENVIRONMENT CONFIGURATION (.env)
# Copy this file to .env in the project root: copy .env.example .env
# ==============================================================================

# Core Settings
DEBUG=True
SECRET_KEY=django-insecure-ca2-local-development-key
ALLOWED_HOSTS=*

# ==============================================================================
# 1. UPSTASH REDIS CONFIGURATION (Choose Option A or Option B)
# ==============================================================================

# OPTION A: Redis Connection String (Recommended)
# Found under Upstash Console -> Database -> "Connect" -> "redis-cli / redis-py"
UPSTASH_REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_UPSTASH_ENDPOINT.upstash.io:6379

# OPTION B: Upstash REST Credentials (Automatically converted to TLS rediss://)
# UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_ENDPOINT.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# ==============================================================================
# 2. DATABASE CONFIGURATION (Optional - defaults to local db.sqlite3 if omitted)
# ==============================================================================
# If using external PostgreSQL (Neon, Supabase, AWS RDS, Render):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Or individual Postgres parameters:
# POSTGRES_DB=lms_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

